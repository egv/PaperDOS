{"method":"item/completed","params":{"item":{"type":"commandExecution","id":"call_foVdbk7WmQn2AqUHyuP0JWuA","command":"/bin/sh -c \"nl -ba kernel/tests/launcher_stages.rs | sed -n '1,260p'\"","cwd":"/Users/egv/dev/PaperDOS/.yolo-runner/clones/bd-976e.2","processId":"2924","status":"completed","commandActions":[{"type":"read","command":"nl -ba kernel/tests/launcher_stages.rs | sed -n '1,260p'","name":"launcher_stages.rs","path":"kernel/tests/launcher_stages.rs"}],"aggregatedOutput":"     1\t// BR-P1-G2: Instrument launcher→loader→jump path and add no-jump validation mode.\n     2\t//\n     3\t// Tests verify that each launch stage emits its serial tag, and that DryRun\n     4\t// mode loads and prepares the image without invoking the real jump entry point.\n     5\t\n     6\tmod common;\n     7\t\n     8\tuse core::sync::atomic::{AtomicBool, Ordering};\n     9\t\n    10\tuse common::InMemoryBlockDevice;\n    11\tuse kernel::abi::PdSyscalls;\n    12\tuse kernel::boot_app::{load_and_run, JumpMode};\n    13\tuse kernel::device::serial::set_serial_write_fn;\n    14\tuse kernel::storage::fs::FsState;\n    15\tuse kernel::syscall::build_syscall_table;\n    16\t\n    17\t// ── Stage-detection globals ───────────────────────────────────────────────────\n    18\t\n    19\tstatic SAW_CONFIRM: AtomicBool = AtomicBool::new(false);\n    20\tstatic SAW_SELECT: AtomicBool = AtomicBool::new(false);\n    21\tstatic SAW_OPEN: AtomicBool = AtomicBool::new(false);\n    22\tstatic SAW_READ: AtomicBool = AtomicBool::new(false);\n    23\tstatic SAW_PREPARE: AtomicBool = AtomicBool::new(false);\n    24\tstatic SAW_JUMP: AtomicBool = AtomicBool::new(false);\n    25\tstatic JUMP_FN_CALLED: AtomicBool = AtomicBool::new(false);\n    26\t\n    27\tfn stage_recording_write(bytes: &[u8]) {\n    28\t    if bytes == b\"LAUNCH:confirm\\n\" {\n    29\t        SAW_CONFIRM.store(true, Ordering::SeqCst);\n    30\t    } else if bytes == b\"LAUNCH:select\\n\" {\n    31\t        SAW_SELECT.store(true, Ordering::SeqCst);\n    32\t    } else if bytes == b\"LAUNCH:open\\n\" {\n    33\t        SAW_OPEN.store(true, Ordering::SeqCst);\n    34\t    } else if bytes == b\"LAUNCH:read\\n\" {\n    35\t        SAW_READ.store(true, Ordering::SeqCst);\n    36\t    } else if bytes == b\"LAUNCH:prepare\\n\" {\n    37\t        SAW_PREPARE.store(true, Ordering::SeqCst);\n    38\t    } else if bytes == b\"LAUNCH:jump\\n\" {\n    39\t        SAW_JUMP.store(true, Ordering::SeqCst);\n    40\t    }\n    41\t}\n    42\t\n    43\tunsafe fn mock_jump_record(_entry: *const u8, _syscalls: *const PdSyscalls) {\n    44\t    JUMP_FN_CALLED.store(true, Ordering::SeqCst);\n    45\t}\n    46\t\n    47\t// ── Tests ─────────────────────────────────────────────────────────────────────\n    48\t\n    49\t/// All six stage tags must be written to serial for a successful load+jump.\n    50\t#[test]\n    51\tfn all_stages_logged_for_valid_pdb_launcher_stages() {\n    52\t    // SAFETY: called once per test binary; no concurrent writer.\n    53\t    unsafe { set_serial_write_fn(stage_recording_write) };\n    54\t\n    55\t    SAW_CONFIRM.store(false, Ordering::SeqCst);\n    56\t    SAW_SELECT.store(false, Ordering::SeqCst);\n    57\t    SAW_OPEN.store(false, Ordering::SeqCst);\n    58\t    SAW_READ.store(false, Ordering::SeqCst);\n    59\t    SAW_PREPARE.store(false, Ordering::SeqCst);\n    60\t    SAW_JUMP.store(false, Ordering::SeqCst);\n    61\t    JUMP_FN_CALLED.store(false, Ordering::SeqCst);\n    62\t\n    63\t    let bd = InMemoryBlockDevice::new(common::make_valid_apps_fat16_image());\n    64\t    let mut fs = FsState::new(bd);\n    65\t    let mut pdb_buf = [0u8; 512];\n    66\t    let mut app_region = [0u8; 256];\n    67\t    let syscalls = build_syscall_table(0, 0);\n    68\t\n    69\t    let result = unsafe {\n    70\t        load_and_run(\n    71\t            &mut fs,\n    72\t            b\"HELLO   PDB\",\n    73\t            &mut pdb_buf,\n    74\t            &mut app_region,\n    75\t            &syscalls,\n    76\t            JumpMode::Jump(mock_jump_record),\n    77\t        )\n    78\t    };\n    79\t\n    80\t    assert!(result.is_ok(), \"valid PDB must load: {result:?}\");\n    81\t    assert!(\n    82\t        JUMP_FN_CALLED.load(Ordering::SeqCst),\n    83\t        \"jump function must be called\"\n    84\t    );\n    85\t    assert!(\n    86\t        SAW_CONFIRM.load(Ordering::SeqCst),\n    87\t        \"LAUNCH:confirm must be logged\"\n    88\t    );\n    89\t    assert!(\n    90\t        SAW_SELECT.load(Ordering::SeqCst),\n    91\t        \"LAUNCH:select must be logged\"\n    92\t    );\n    93\t    assert!(\n    94\t        SAW_OPEN.load(Ordering::SeqCst),\n    95\t        \"LAUNCH:open must be logged\"\n    96\t    );\n    97\t    assert!(\n    98\t        SAW_READ.load(Ordering::SeqCst),\n    99\t        \"LAUNCH:read must be logged\"\n   100\t    );\n   101\t    assert!(\n   102\t        SAW_PREPARE.load(Ordering::SeqCst),\n   103\t        \"LAUNCH:prepare must be logged\"\n   104\t    );\n   105\t    assert!(\n   106\t        SAW_JUMP.load(Ordering::SeqCst),\n   107\t        \"LAUNCH:jump must be logged\"\n   108\t    );\n   109\t}\n   110\t\n   111\t/// DryRun mode must load and prepare the image and return `Ok(())` without\n   112\t/// panicking or executing any user-provided entry point.\n   113\t///\n   114\t/// The LAUNCH:jump tag is still emitted (so the host sees the full serial\n   115\t/// trace up to the branch point), but the entry function is not invoked.\n   116\t/// Correctness is demonstrated by the successful return value and the presence\n   117\t/// of the prepare stage tag.\n   118\t#[test]\n   119\tfn dry_run_loads_without_calling_jump_launcher_stages() {\n   120\t    // SAFETY: idempotent; same fn as the other test.\n   121\t    unsafe { set_serial_write_fn(stage_recording_write) };\n   122\t\n   123\t    SAW_CONFIRM.store(false, Ordering::SeqCst);\n   124\t    SAW_SELECT.store(false, Ordering::SeqCst);\n   125\t    SAW_PREPARE.store(false, Ordering::SeqCst);\n   126\t    SAW_JUMP.store(false, Ordering::SeqCst);\n   127\t\n   128\t    let bd = InMemoryBlockDevice::new(common::make_valid_apps_fat16_image());\n   129\t    let mut fs = FsState::new(bd);\n   130\t    let mut pdb_buf = [0u8; 512];\n   131\t    let mut app_region = [0u8; 256];\n   132\t    let syscalls = build_syscall_table(0, 0);\n   133\t\n   134\t    let result = unsafe {\n   135\t        load_and_run(\n   136\t            &mut fs,\n   137\t            b\"HELLO   PDB\",\n   138\t            &mut pdb_buf,\n   139\t            &mut app_region,\n   140\t            &syscalls,\n   141\t            JumpMode::DryRun,\n   142\t        )\n   143\t    };\n   144\t\n   145\t    assert!(result.is_ok(), \"dry-run must succeed: {result:?}\");\n   146\t    assert!(\n   147\t        SAW_CONFIRM.load(Ordering::SeqCst),\n   148\t        \"LAUNCH:confirm must be logged in dry-run\"\n   149\t    );\n   150\t    assert!(\n   151\t        SAW_SELECT.load(Ordering::SeqCst),\n   152\t        \"LAUNCH:select must be logged in dry-run\"\n   153\t    );\n   154\t    assert!(\n   155\t        SAW_PREPARE.load(Ordering::SeqCst),\n   156\t        \"LAUNCH:prepare must be logged in dry-run\"\n   157\t    );\n   158\t    assert!(\n   159\t        SAW_JUMP.load(Ordering::SeqCst),\n   160\t        \"LAUNCH:jump must be logged in dry-run\"\n   161\t    );\n   162\t}\n","exitCode":0,"durationMs":0},"threadId":"019d544d-579a-76c0-a762-28c36384f38f","turnId":"019d544d-579c-7951-a98e-44ece7e079a5"}}
