{"method":"item/completed","params":{"item":{"type":"commandExecution","id":"call_MkrAO8aP5pPWNAKE0NpmlSDO","command":"/bin/sh -c \"nl -ba kernel/tests/boot_app.rs | sed -n '1,320p'\"","cwd":"/Users/egv/dev/PaperDOS/.yolo-runner/clones/bd-976e.2","processId":"34134","status":"completed","commandActions":[{"type":"read","command":"nl -ba kernel/tests/boot_app.rs | sed -n '1,320p'","name":"boot_app.rs","path":"kernel/tests/boot_app.rs"}],"aggregatedOutput":"     1\tmod common;\n     2\t\n     3\tuse core::sync::atomic::{AtomicBool, Ordering};\n     4\t\n     5\tuse common::InMemoryBlockDevice;\n     6\tuse kernel::abi::{PdSyscalls, PD_ABI_VERSION};\n     7\tuse kernel::boot_app::{load_and_run, JumpMode, LoadAndRunError};\n     8\tuse kernel::device::serial::set_serial_write_fn;\n     9\tuse kernel::storage::fs::FsState;\n    10\tuse kernel::syscall::build_syscall_table;\n    11\t\n    12\tstatic SAW_SELECT: AtomicBool = AtomicBool::new(false);\n    13\tstatic SAW_OPEN: AtomicBool = AtomicBool::new(false);\n    14\tstatic SAW_STAT: AtomicBool = AtomicBool::new(false);\n    15\tstatic SAW_READ: AtomicBool = AtomicBool::new(false);\n    16\t\n    17\tstatic SAW_JUMP: AtomicBool = AtomicBool::new(false);\n    18\tstatic SAW_RETURNED: AtomicBool = AtomicBool::new(false);\n    19\t\n    20\tfn stage_write(bytes: &[u8]) {\n    21\t    if bytes == b\"LAUNCH:select\\n\" {\n    22\t        SAW_SELECT.store(true, Ordering::SeqCst);\n    23\t    } else if bytes == b\"LAUNCH:stat\\n\" {\n    24\t        SAW_STAT.store(true, Ordering::SeqCst);\n    25\t    } else if bytes == b\"LAUNCH:open\\n\" {\n    26\t        SAW_OPEN.store(true, Ordering::SeqCst);\n    27\t    } else if bytes == b\"LAUNCH:read\\n\" {\n    28\t        SAW_READ.store(true, Ordering::SeqCst);\n    29\t    } else if bytes == b\"LAUNCH:jump\\n\" {\n    30\t        SAW_JUMP.store(true, Ordering::SeqCst);\n    31\t    } else if bytes == b\"LAUNCH:returned\\n\" {\n    32\t        SAW_RETURNED.store(true, Ordering::SeqCst);\n    33\t    }\n    34\t}\n    35\t\n    36\t/// All four file-load stage tags must be emitted for a successful load.\n    37\t#[test]\n    38\tfn pdb_file_load_stages_emitted_boot_app() {\n    39\t    // SAFETY: called once per test binary; no concurrent writer.\n    40\t    unsafe { set_serial_write_fn(stage_write) };\n    41\t\n    42\t    SAW_SELECT.store(false, Ordering::SeqCst);\n    43\t    SAW_STAT.store(false, Ordering::SeqCst);\n    44\t    SAW_OPEN.store(false, Ordering::SeqCst);\n    45\t    SAW_READ.store(false, Ordering::SeqCst);\n    46\t\n    47\t    let bd = InMemoryBlockDevice::new(common::make_valid_apps_fat16_image());\n    48\t    let mut fs = FsState::new(bd);\n    49\t    let mut pdb_buf = [0u8; 512];\n    50\t    let mut app_region = [0u8; 256];\n    51\t    let syscalls = build_syscall_table(0, 0);\n    52\t\n    53\t    let result = unsafe {\n    54\t        load_and_run(\n    55\t            &mut fs,\n    56\t            b\"HELLO   PDB\",\n    57\t            &mut pdb_buf,\n    58\t            &mut app_region,\n    59\t            &syscalls,\n    60\t            JumpMode::DryRun,\n    61\t        )\n    62\t    };\n    63\t\n    64\t    assert!(result.is_ok(), \"valid PDB must load: {result:?}\");\n    65\t    assert!(\n    66\t        SAW_SELECT.load(Ordering::SeqCst),\n    67\t        \"LAUNCH:select must be logged\"\n    68\t    );\n    69\t    assert!(\n    70\t        SAW_STAT.load(Ordering::SeqCst),\n    71\t        \"LAUNCH:stat must be logged\"\n    72\t    );\n    73\t    assert!(\n    74\t        SAW_OPEN.load(Ordering::SeqCst),\n    75\t        \"LAUNCH:open must be logged\"\n    76\t    );\n    77\t    assert!(\n    78\t        SAW_READ.load(Ordering::SeqCst),\n    79\t        \"LAUNCH:read must be logged\"\n    80\t    );\n    81\t}\n    82\t\n    83\tstatic JUMP_CALLED: AtomicBool = AtomicBool::new(false);\n    84\t\n    85\tunsafe fn mock_jump(_entry: *const u8, _syscalls: *const PdSyscalls) {\n    86\t    JUMP_CALLED.store(true, Ordering::SeqCst);\n    87\t}\n    88\t\n    89\t#[test]\n    90\tfn boot_app_load_and_run_reads_named_pdb_and_jumps() {\n    91\t    JUMP_CALLED.store(false, Ordering::SeqCst);\n    92\t    let bd = InMemoryBlockDevice::new(common::make_valid_apps_fat16_image());\n    93\t    let mut fs = FsState::new(bd);\n    94\t    let mut pdb_buf = [0u8; 512];\n    95\t    let mut app_region = [0u8; 256];\n    96\t    let syscalls = build_syscall_table(0, 0);\n    97\t\n    98\t    let result = unsafe {\n    99\t        load_and_run(\n   100\t            &mut fs,\n   101\t            b\"HELLO   PDB\",\n   102\t            &mut pdb_buf,\n   103\t            &mut app_region,\n   104\t            &syscalls,\n   105\t            JumpMode::Jump(mock_jump),\n   106\t        )\n   107\t    };\n   108\t\n   109\t    assert!(\n   110\t        result.is_ok(),\n   111\t        \"valid PDB on FAT image must load: {result:?}\"\n   112\t    );\n   113\t    assert!(JUMP_CALLED.load(Ordering::SeqCst), \"jump must be invoked\");\n   114\t}\n   115\t\n   116\t#[test]\n   117\tfn boot_app_load_and_run_reports_small_scratch_buffer() {\n   118\t    let bd = InMemoryBlockDevice::new(common::make_valid_apps_fat16_image());\n   119\t    let mut fs = FsState::new(bd);\n   120\t    let mut pdb_buf = [0u8; 32];\n   121\t    let mut app_region = [0u8; 256];\n   122\t    let syscalls = build_syscall_table(0, 0);\n   123\t\n   124\t    let result = unsafe {\n   125\t        load_and_run(\n   126\t            &mut fs,\n   127\t            b\"HELLO   PDB\",\n   128\t            &mut pdb_buf,\n   129\t            &mut app_region,\n   130\t            &syscalls,\n   131\t            JumpMode::Jump(mock_jump),\n   132\t        )\n   133\t    };\n   134\t\n   135\t    assert!(matches!(result, Err(LoadAndRunError::FileTooLarge { .. })));\n   136\t}\n   137\t\n   138\t#[test]\n   139\tfn boot_app_test_data_matches_kernel_abi() {\n   140\t    assert_eq!(PD_ABI_VERSION, 1);\n   141\t}\n   142\t\n   143\t/// Regression: after the loaded application entry returns, the kernel must emit\n   144\t/// `LAUNCH:returned`.  On hardware this tag is serial evidence that control\n   145\t/// came back cleanly; its absence means the app (or jump) crashed.\n   146\t#[test]\n   147\tfn jump_path_emits_returned_after_entry_boot_app() {\n   148\t    SAW_RETURNED.store(false, Ordering::SeqCst);\n   149\t    SAW_JUMP.store(false, Ordering::SeqCst);\n   150\t    JUMP_CALLED.store(false, Ordering::SeqCst);\n   151\t    // SAFETY: called once per test binary; no concurrent writer.\n   152\t    unsafe { set_serial_write_fn(stage_write) };\n   153\t\n   154\t    let bd = InMemoryBlockDevice::new(common::make_valid_apps_fat16_image());\n   155\t    let mut fs = FsState::new(bd);\n   156\t    let mut pdb_buf = [0u8; 512];\n   157\t    let mut app_region = [0u8; 256];\n   158\t    let syscalls = build_syscall_table(0, 0);\n   159\t\n   160\t    let result = unsafe {\n   161\t        load_and_run(\n   162\t            &mut fs,\n   163\t            b\"HELLO   PDB\",\n   164\t            &mut pdb_buf,\n   165\t            &mut app_region,\n   166\t            &syscalls,\n   167\t            JumpMode::Jump(mock_jump),\n   168\t        )\n   169\t    };\n   170\t\n   171\t    assert!(result.is_ok(), \"jump path must succeed: {result:?}\");\n   172\t    assert!(\n   173\t        SAW_JUMP.load(Ordering::SeqCst),\n   174\t        \"LAUNCH:jump must be emitted before entry\"\n   175\t    );\n   176\t    assert!(\n   177\t        JUMP_CALLED.load(Ordering::SeqCst),\n   178\t        \"entry must be invoked\"\n   179\t    );\n   180\t    assert!(\n   181\t        SAW_RETURNED.load(Ordering::SeqCst),\n   182\t        \"LAUNCH:returned must be emitted after control returns — serial evidence of clean return\"\n   183\t    );\n   184\t}\n   185\t\n   186\t/// Regression: `LAUNCH:jump` must be emitted immediately before the kernel\n   187\t/// transfers control to the loaded application entry point.  This is