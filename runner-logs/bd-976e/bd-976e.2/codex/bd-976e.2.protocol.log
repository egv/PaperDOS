{"method":"item/completed","params":{"item":{"type":"commandExecution","id":"call_S0r2hNai69o3QXsRjbPK8Juf","command":"/bin/sh -c \"nl -ba kernel/src/loader.rs | sed -n '1,260p'\"","cwd":"/Users/egv/dev/PaperDOS/.yolo-runner/clones/bd-976e.2","processId":"48611","status":"completed","commandActions":[{"type":"read","command":"nl -ba kernel/src/loader.rs | sed -n '1,260p'","name":"loader.rs","path":"kernel/src/loader.rs"}],"aggregatedOutput":"     1\tuse crate::abi::PdSyscalls;\n     2\tuse crate::device::serial::serial_write_bytes;\n     3\tuse crate::pdb::{\n     4\t    parse_fixed_header, payload_views, validate_header_identity, PdbError, PdbHeader,\n     5\t};\n     6\t\n     7\t#[derive(Clone, Copy, Debug, Eq, PartialEq)]\n     8\tpub enum LoaderError {\n     9\t    RamBudgetOverflow,\n    10\t    AppRegionTooSmall {\n    11\t        required: u32,\n    12\t        available: u32,\n    13\t    },\n    14\t    BssOutOfBounds {\n    15\t        start: usize,\n    16\t        end: usize,\n    17\t        region_len: usize,\n    18\t    },\n    19\t    RelocationOutOfBounds {\n    20\t        offset: usize,\n    21\t        image_len: usize,\n    22\t    },\n    23\t    EntryOffsetOutOfBounds {\n    24\t        entry_offset: u32,\n    25\t        image_len: usize,\n    26\t    },\n    27\t}\n    28\t\n    29\t#[derive(Clone, Copy, Debug, Eq, PartialEq)]\n    30\tpub enum PrepareImageError {\n    31\t    Pdb(PdbError),\n    32\t    Loader(LoaderError),\n    33\t}\n    34\t\n    35\t#[derive(Clone, Copy, Debug, Eq, PartialEq)]\n    36\tpub struct PreparedImage {\n    37\t    pub entry_offset: u32,\n    38\t    pub image_size: u32,\n    39\t    pub total_ram: u32,\n    40\t    pub min_heap: u32,\n    41\t}\n    42\t\n    43\timpl From<PdbError> for PrepareImageError {\n    44\t    fn from(value: PdbError) -> Self {\n    45\t        Self::Pdb(value)\n    46\t    }\n    47\t}\n    48\t\n    49\timpl From<LoaderError> for PrepareImageError {\n    50\t    fn from(value: LoaderError) -> Self {\n    51\t        Self::Loader(value)\n    52\t    }\n    53\t}\n    54\t\n    55\tpub fn ram_budget_bytes(header: &PdbHeader) -> Result<u32, LoaderError> {\n    56\t    header\n    57\t        .text_size\n    58\t        .checked_add(header.data_size)\n    59\t        .and_then(|total| total.checked_add(header.bss_size))\n    60\t        .and_then(|total| total.checked_add(header.min_heap))\n    61\t        .ok_or(LoaderError::RamBudgetOverflow)\n    62\t}\n    63\t\n    64\tpub fn ensure_region_fit(required: u32, available: u32) -> Result<(), LoaderError> {\n    65\t    if required > available {\n    66\t        return Err(LoaderError::AppRegionTooSmall {\n    67\t            required,\n    68\t            available,\n    69\t        });\n    70\t    }\n    71\t\n    72\t    Ok(())\n    73\t}\n    74\t\n    75\tpub fn zero_bss_tail(\n    76\t    region: &mut [u8],\n    77\t    initialized_size: u32,\n    78\t    bss_size: u32,\n    79\t) -> Result<(), LoaderError> {\n    80\t    let start = initialized_size as usize;\n    81\t    let end = start.saturating_add(bss_size as usize);\n    82\t\n    83\t    if end > region.len() {\n    84\t        return Err(LoaderError::BssOutOfBounds {\n    85\t            start,\n    86\t            end,\n    87\t            region_len: region.len(),\n    88\t        });\n    89\t    }\n    90\t\n    91\t    region[start..end].fill(0);\n    92\t    Ok(())\n    93\t}\n    94\t\n    95\tpub fn apply_relocations(\n    96\t    image: &mut [u8],\n    97\t    reloc_table: &[u8],\n    98\t    load_address: u32,\n    99\t) -> Result<(), LoaderError> {\n   100\t    for entry in reloc_table.chunks_exact(4) {\n   101\t        let offset = u32::from_le_bytes(entry.try_into().unwrap()) as usize;\n   102\t        let end = offset + 4;\n   103\t\n   104\t        if end > image.len() {\n   105\t            return Err(LoaderError::RelocationOutOfBounds {\n   106\t                offset,\n   107\t                image_len: image.len(),\n   108\t            });\n   109\t        }\n   110\t\n   111\t        let value = u32::from_le_bytes(image[offset..end].try_into().unwrap());\n   112\t        let relocated = value.wrapping_add(load_address);\n   113\t        image[offset..end].copy_from_slice(&relocated.to_le_bytes());\n   114\t    }\n   115\t\n   116\t    Ok(())\n   117\t}\n   118\t\n   119\t/// Error returned by [`load_and_run`].\n   120\t#[derive(Clone, Copy, Debug, Eq, PartialEq)]\n   121\tpub enum LoadAndRunError {\n   122\t    PrepareImage(PrepareImageError),\n   123\t}\n   124\t\n   125\timpl From<PrepareImageError> for LoadAndRunError {\n   126\t    fn from(e: PrepareImageError) -> Self {\n   127\t        Self::PrepareImage(e)\n   128\t    }\n   129\t}\n   130\t\n   131\t/// Parse and validate `pdb`, copy the image into `region`, apply relocations,\n   132\t/// and call `jump_fn` with the resolved entry pointer.\n   133\t///\n   134\t/// `jump_fn` defaults to [`crate::jump::jump_to_app`] in production; pass\n   135\t/// a mock during tests to avoid executing arbitrary bytes on the host.\n   136\t///\n   137\t/// # Safety\n   138\t/// `jump_fn` must be safe to call with the entry pointer derived from `region`\n   139\t/// and the provided `syscalls` pointer.\n   140\tpub unsafe fn load_and_run(\n   141\t    pdb: &[u8],\n   142\t    region: &mut [u8],\n   143\t    syscalls: *const PdSyscalls,\n   144\t    jump_fn: unsafe fn(*const u8, *const PdSyscalls),\n   145\t) -> Result<(), LoadAndRunError> {\n   146\t    let load_addr = region.as_ptr() as u32;\n   147\t    let prepared = prepare_image(pdb, region, load_addr)?;\n   148\t    serial_write_bytes(b\"LAUNCH:prepare\\n\");\n   149\t    let entry = unsafe { region.as_ptr().add(prepared.entry_offset as usize) };\n   150\t    serial_write_bytes(b\"LAUNCH:jump\\n\");\n   151\t    unsafe { jump_fn(entry, syscalls) };\n   152\t    serial_write_bytes(b\"LAUNCH:returned\\n\");\n   153\t    Ok(())\n   154\t}\n   155\t\n   156\tpub fn prepare_image(\n   157\t    bytes: &[u8],\n   158\t    region: &mut [u8],\n   159\t    load_address: u32,\n   160\t) -> Result<PreparedImage, PrepareImageError> {\n   161\t    let header = parse_fixed_header(bytes)?;\n   162\t    validate_header_identity(&header)?;\n   163\t\n   164\t    let views = payload_views(&header, bytes)?;\n   165\t    let total_ram = ram_budget_bytes(&header)?;\n   166\t    let available = u32::try_from(region.len()).unwrap_or(u32::MAX);\n   167\t    ensure_region_fit(total_ram, available)?;\n   168\t\n   169\t    let image_size = views.image.len();\n   170\t    if header.entry_offset >= header.text_size {\n   171\t        return Err(LoaderError::EntryOffsetOutOfBounds {\n   172\t            entry_offset: header.entry_offset,\n   173\t            image_len: header.text_size as usize,\n   174\t        }\n   175\t        .into());\n   176\t    }\n   177\t\n   178\t    region[..image_size].copy_from_slice(views.image);\n   179\t    zero_bss_tail(region, image_size as u32, header.bss_size)?;\n   180\t    apply_relocations(&mut region[..image_size], views.reloc_table, load_address)?;\n   181\t\n   182\t    Ok(PreparedImage {\n   183\t        entry_offset: header.entry_offset,\n   184\t        image_size: image_size as u32,\n   185\t        total_ram,\n   186\t        min_heap: header.min_heap,\n   187\t    })\n   188\t}\n","exitCode":0,"durationMs":0},"threadId":"019d544d-579a-76c0-a762-28c36384f38f","turnId":"019d544d-579c-7951-a98e-44ece7e079a5"}}
